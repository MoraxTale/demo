<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.AdventureController"
      spacing="20"
      alignment="CENTER"
      style="-fx-padding: 20; -fx-background-color: #f0e6d2;">

    <Label text="秘境探索" style="-fx-font-size: 24; -fx-font-family: 'SimSun'; -fx-text-fill: #8B4513;"/>

    <HBox spacing="15" alignment="CENTER">
        <!-- 迷雾森林按钮，替换为自定义图片 -->
        <Button fx:id="area1Btn"
                onAction="#handleArea1"
                style="-fx-background-color: transparent; -fx-padding: 0;">
            <graphic>
                <ImageView fitWidth="100" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="file:E:/JAVA%20FX/demo/pic/area1.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <!-- 熔岩洞窟按钮，替换为自定义图片 -->
        <Button fx:id="area2Btn"
                onAction="#handleArea2"
                style="-fx-background-color: transparent; -fx-padding: 0;">
            <graphic>
                <ImageView fitWidth="100" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="file:E:/JAVA%20FX/demo/pic/area2.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <!-- 虚空幻境按钮，替换为自定义图片 -->
        <Button fx:id="area3Btn"
                onAction="#handleArea3"
                style="-fx-background-color: transparent; -fx-padding: 0;">
            <graphic>
                <ImageView fitWidth="100" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="file:E:/JAVA%20FX/demo/pic/area3.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <HBox spacing="15" alignment="CENTER">
        <!-- 古神遗迹按钮，替换为自定义图片 -->
        <Button fx:id="area4Btn"
                onAction="#handleArea4"
                style="-fx-background-color: transparent; -fx-padding: 0;">
            <graphic>
                <ImageView fitWidth="100" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="file:E:/JAVA%20FX/demo/pic/area4.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <!-- 无尽深渊按钮，替换为自定义图片 -->
        <Button fx:id="area5Btn"
                onAction="#handleArea5"
                style="-fx-background-color: transparent; -fx-padding: 0;">
            <graphic>
                <ImageView fitWidth="100" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="file:E:/JAVA%20FX/demo/pic/area5.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <Label fx:id="lblResult" style="-fx-font-size: 16; -fx-font-family: 'SimSun'; -fx-text-fill: #8B0000;"/>
    <Label fx:id="lblTimer" style="-fx-font-size: 20; -fx-text-fill: #2E8B57;"/>
</VBox>

